[Unit]
Description=Hisense Roku Voice Remote
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/hisense-remote
Environment=DATA_DIR=/var/lib/hisense-remote
ExecStart=/usr/bin/docker compose up --build
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
